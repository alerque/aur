pkgbase = lcmark-git
	pkgdesc = A higher level Lua interface exposing lua-cmark features
	pkgver = 0.31.1.1.r0.gdebdae3
	pkgrel = 1
	url = https://github.com/jgm/lcmark
	arch = x86_64
	arch = i686
	license = BSD
	makedepends = git
	makedepends = lua
	makedepends = lua54
	makedepends = lua53
	makedepends = lua52
	makedepends = lua51
	makedepends = luarocks
	source = git+https://github.com/jgm/lcmark.git#branch=master
	sha256sums = SKIP

pkgname = lcmark-git
	pkgdesc = CLI interface for lua-lcmark
	depends = lua
	depends = lcmark-git
	provides = lcmark
	conflicts = lcmark

pkgname = lua-lcmark-git
	depends = lua
	depends = lua-cmark-git
	depends = lua-lpeg
	depends = lua-optparse
	depends = lua-yaml
	provides = lua-lcmark
	conflicts = lua-lcmark

