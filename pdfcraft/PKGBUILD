# Maintainer: Caleb Maclennan <caleb@alerque.com>

pkgname=pdfcraft
pkgver=0.15.0
pkgrel=1
url="https://getartcraft.com/apps/$pkgname"
_url="https://github.com/storytold/$pkgname"
pkgdesc='vibe coded clean-room reimplementation of Adobe Acrobat'
arch=(x86_64)
license=(MIT Apache-2.0 CC-BY-SA-4.0)
depends=(glibc # libc.so libm.so
         hicolor-icon-theme
         libgcc)
makedepends=(cargo)
provides=(printcraft)
conflicts=(printcraft)
replaces=(printcraft)
_archive="$pkgname-$pkgver"
_models="https://ocrs-models.s3-accelerate.amazonaws.com"
source=("$_url/archive/refs/tags/v$pkgver/$_archive.tar.gz"
        "$_models/text-detection.onnx"
        "$_models/text-recognition.onnx")
sha256sums=('0e20c8675238a7576883587db144fdccfb968504101d79f82be436a593188536'
            'a917b23dbd9524b465df7e922641b3ff2981623df4ded5a0234004ef2fee7cfe'
            '86c145c2edb96c8caed5b1ebb8f44d706408922211451c309c625157dd6061c5')

_srcenv() {
	cd "$_archive"
	export CARGO_HOME="$srcdir"
	if check_option debug y; then
		export CARGO_PROFILE_RELEASE_DEBUG=2
		export CARGO_PROFILE_RELEASE_STRIP=false
	fi
	if check_option lto y; then
		export CARGO_PROFILE_RELEASE_LTO=thin
		export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=1
	fi
	export CARGO_PROFILE_RELEASE_OPT_LEVEL=3
	CFLAGS+=' -fno-lto'
	export CARGO_TARGET_DIR=target
	export RUSTUP_TOOLCHAIN=stable
}

_icons=(512 256 128 64 48 32 16)

prepare() {
	_srcenv
	cargo fetch --locked --target host-tuple
}

build() {
	_srcenv
	cargo build --frozen --release
}

package() {
	depends+=(libgcc_s.so)
	cd "$_archive"
	install -Dm0755 -t "$pkgdir/usr/bin/" "target/release/$pkgname"{,-cli}
	install -Dm0644 -t "$pkgdir/usr/share/applications/" "packaging/linux/ai.storyteller.$pkgname.desktop"
	install -Dm0644 -t "$pkgdir/usr/share/mime/packages/" "packaging/linux/ai.storyteller.$pkgname.mime.xml"
	install -Dm0644 -t "$pkgdir/usr/share/icons/hicolor/scalable/" assets/app-icon/hicolor/scalable/apps/ai.storyteller.$pkgname.svg
	for s in ${_icons[@]}; do
		local dim="${s}x${s}"
		install -Dm0644 -t "$pkgdir/usr/share/icons/hicolor/$dim/apps/" assets/app-icon/hicolor/$dim/apps/ai.storyteller.$pkgname.png
	done
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE-{APACHE,MIT}
	# the app looks for OCR models in ../share/pdfcraft/models relative to its binary
	install -Dm0644 -t "$pkgdir/usr/share/$pkgname/models/" "$srcdir"/text-{detection,recognition}.onnx
}
