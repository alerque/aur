pkgname=marktext
pkgver=0.21.1
pkgrel=1
pkgdesc='A simple and elegant open-source markdown editor that focused on speed and usability'
arch=(x86_64)
url=https://www.marktext.cc
_url="https://github.com/$pkgname/$pkgname"
license=(MIT)
_electron=electron42
depends=("$_electron"
         hicolor-icon-theme
         libsecret
         libxkbfile
         openssl
         pandoc
         ripgrep)
makedepends=(git
             moreutils
             node-gyp
             nodejs-lts-krypton
             pnpm
             yq)
_archive="$pkgname-$pkgver"
source=("$_url/archive/refs/tags/v$pkgver/$_archive.tar.gz"
        "$pkgname.sh"
        "$pkgname-arg-handling.patch"
        "$pkgname-static-path.patch"
        "$pkgname-window-icon.patch")
sha256sums=('36491b6e02a871ef5c4997939952c5d01116b608395ee97adbee3c760279c578'
            '8f37f164a642a536b75f54b49e7c7a7c1e4d355a91dd8ece4cab6a95b42d369e'
            '09dcb2b527a426a6ca051ea6468c74ab2bb9c78e01d00ddda1f60aa518adf057'
            'c6bdeb26ef029901178ca84e4d5654d5a27e4e96af208d8631948d62e3ad3172'
            'f8b69a02f06df0b95fa97756caf8fcefa8da2a66d7a25ae2748ea2172a0c966c')

prepare() {
	cd "$_archive"
	patch -p1 < "$srcdir/$pkgname-arg-handling.patch"
	patch -p1 < "$srcdir/$pkgname-static-path.patch"
	patch -p1 < "$srcdir/$pkgname-window-icon.patch"
	sed -e "s/@ELECTRON@/$_electron/" "$srcdir/$pkgname.sh" > "$pkgname"
	local builder=packages/desktop/electron-builder.yml 
	yq -y '(.linux.target) = ["dir"]' "$builder" | sponge "$builder"
	export ELECTRON_SKIP_BINARY_DOWNLOAD=1
	export PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
	export PNPM_HOME="$srcdir/.pnpm-home"
	pnpm config set store-dir "$srcdir/.pnpm-store"
	pnpm install --frozen-lockfile --ignore-scripts
}

build() {
	cd "$_archive"
	export PNPM_HOME="$srcdir/.pnpm-home"
	pnpm --filter marktext build:unpack
	pnpm --filter marktext build:linux -- --linux dir --x64 --publish never
}

package() {
	cd "$_archive"
	install -Dm0755 -t "$pkgdir/usr/bin/" "$pkgname"
	local dist=dist/linux-unpacked/resources
	install -Dm0644 -t "$pkgdir/usr/lib/$pkgname/" "$dist/app.asar"
	cp -a "$dist/"{app.asar.unpacked,static} "$pkgdir/usr/lib/$pkgname/"
	local _rg_path="$pkgdir/usr/lib/$pkgname/app.asar.unpacked/node_modules/@vscode/ripgrep-linux-x64/bin/"
	ln -sf /usr/bin/rg "$_rg_path"
	install -Dm0644 -t "$pkgdir/usr/share/licenses/$pkgname/" LICENSE
	install -Dm0755 -t "$pkgdir/usr/share/applications/" "packages/desktop/build/linux/$pkgname.desktop"
	install -Dm0755 -t "$pkgdir/usr/share/metainfo/" "packages/desktop/build/linux/$pkgname.appdata.xml"
	pushd packages/desktop/build/icons
	find -name "$pkgname.png" -exec install -Dm0644 {} "$pkgdir/usr/share/icons/hicolor/{}" \;
}
